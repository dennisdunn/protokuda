{
  "name": "protokuda",
  "version": "3.0.0",
  "description": "A Star Trek-ish stylesheet: what Michael Okuda might have drawn on his way to LCARS.",
  "keywords": [
    "css",
    "lcars",
    "star-trek",
    "theme"
  ],
  "homepage": "https://dennisdunn.github.io/protokuda/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisdunn/protokuda.git"
  },
  "bugs": "https://github.com/dennisdunn/protokuda/issues",
  "author": "Dennis Dunn <ansofive@gmail.com>",
  "license": "MIT",
  "style": "dist/protokuda.css",
  "jsdelivr": "dist/protokuda.css",
  "unpkg": "dist/protokuda.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "browser-sync start --server demo --ss src --files \"demo/**/*\" \"src/**/*.css\" --no-notify --no-open --port 3000",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build.mjs --site",
    "prepack": "npm run build",
    "preversion": "git fetch --tags",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "lightningcss": "^1.33.0"
  }
}
